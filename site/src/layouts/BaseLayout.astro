---
const { title = "Portfolio", description = "Personal engineering portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-title">Brandon D. Bailey</div>
      <nav class="site-nav" aria-label="Primary">
        <a href="/">Home</a>
        <a href="/projects">Projects</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Brandon D. Bailey · Built with Astro</span>
    </footer>
  </body>
</html>

